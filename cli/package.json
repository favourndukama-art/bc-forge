    "conf": "^16.0.0",
    "dotenv": "^18.0.8",
    "winston": "^3.17.0",
    "chalk": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "@types/node": "^26.6.5"
