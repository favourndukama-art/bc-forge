{
  "name": "@bc-forge/cli",
  "version": "0.1.0",
  "private": true,
  "description": "CLI deployment orchestrator for bc-forge Soroban contracts",
  "type": "module",
  "bin": {
    "bc-forge": "./dist/index.js"
  },
  "scripts": {
