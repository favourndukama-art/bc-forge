{
  "name": "@bc-forge/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for interacting with bc-forge token contracts on Stellar/Soroban",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --experimental-vm-modules ../node_modules/jest/bin/jest.js --passWithNoTests",
    "lint": "eslint src",
    "format": "prettier --write src",

    "clean": "rm -rf dist"
  },
  "keywords": [
    "stellar",
    "soroban",
    "token",
    "blockchain",
    "sdk"
  ],
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.60.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
